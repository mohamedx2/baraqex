{
  "name": "baraqex",
  "version": "2.0.0",
  "description": "⚡ A blazing-fast full-stack framework with WASM superpowers. Build universal apps with React-like syntax and Go-powered performance.",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "browser": "./dist/browser.js",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./browser": {
      "import": "./dist/browser.js",
      "types": "./dist/browser.d.ts"
    },
    "./server": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    },
    "./package.json": "./package.json"
  },
  "browser": {
    "./dist/index.js": "./dist/browser.js",
    "crypto": false,
    "fs": false,
    "path": false,
    "http": false,
    "https": false,
    "express": false,
    "cors": false,
    "mongodb": false,
    "mysql2": false,
    "pg": false,
    "bcryptjs": false,
    "jsonwebtoken": false
  },
  "sideEffects": false,
  "files": [
    "dist/",
    "bin/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "templates/basic-app/",
    "templates/fullstack-template/",
    "templates/ssr-template/",
    "templates/wasm/",
    "!templates/**/node_modules/",
    "!templates/**/dist/",
    "!templates/**/package-lock.json",
    "!templates/wasm/public/*.wasm"
  ],
  "bin": {
    "baraqex": "./bin/baraqex.js"
  },
  "scripts": {
    "build": "npm run clean && npm run build:esm && npm run build:types",
    "build:types": "tsc --emitDeclarationOnly",
    "build:esm": "node build.mjs",
    "clean": "rimraf dist",
    "test": "jest",
    "test:unit": "jest tests/server --coverage",
    "test:integration": "jest tests/server/integration.test.ts",
    "test:coverage": "jest --coverage",
    "test:coverage:report": "jest --coverage && start coverage/lcov-report/index.html",
    "test:watch": "jest --watch",
    "test:benchmarks": "jest benchmarks --verbose",
    "test:ci": "jest --coverage --ci --reporters=default --reporters=jest-junit",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run test && npm run build",
    "prepare": "npm run build",
    "release": "npm run test && npm run build && npm publish",
    "release:beta": "npm run test && npm run build && npm publish --tag beta",
    "docs": "typedoc --out docs src/index.ts",
    "size": "size-limit",
    "benchmark": "jest benchmarks --verbose"
  },
  "keywords": [
    "baraqex",
    "frontend-hamroun",
    "framework",
    "fullstack",
    "frontend",
    "backend",
    "react",
    "jsx",
    "ssr",
    "server-side-rendering",
    "wasm",
    "webassembly",
    "go",
    "golang",
    "typescript",
    "javascript",
    "express",
    "api",
    "rest",
    "web",
    "app",
    "universal",
    "isomorphic",
    "virtual-dom",
    "hooks",
    "arabic"
  ],
  "author": {
    "name": "Mohamed X",
    "url": "https://github.com/mohamedx2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohamedx2/baraqex.git"
  },
  "bugs": {
    "url": "https://github.com/mohamedx2/baraqex/issues"
  },
  "homepage": "https://www.baraqex.tech",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/mohamedx2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "glob": "^11.0.2",
    "open": "^10.1.2",
    "ws": "^8.18.2"
  },
  "peerDependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "cors": {
      "optional": true
    },
    "mongodb": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "bcryptjs": {
      "optional": true
    },
    "jsonwebtoken": {
      "optional": true
    }
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.15.4",
    "@types/supertest": "^6.0.3",
    "esbuild": "^0.19.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "typescript": "^5.0.0"
  },
  "optionalDependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.18.0",
    "jsonwebtoken": "^9.0.0",
    "mongodb": "^6.0.0",
    "mysql2": "^3.6.0",
    "pg": "^8.11.0"
  }
}
