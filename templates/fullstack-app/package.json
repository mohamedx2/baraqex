{
  "name": "fullstack-app",
  "version": "1.0.0",
  "description": "Baraqex full-stack template: frontend + backend + SSR + WebAssembly (Go)",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node dist/server.js",
    "prod": "npm run build && npm run start",
    "dev": "tsx server.ts",
    "build": "node build.mjs",
    "build:wasm": "node build-wasm.js",
    "build:all": "node build-wasm.js && node build.mjs"
  },
  "dependencies": {
    "baraqex": "latest",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "@types/compression": "^1.7.3",
    "@types/cors": "^2.8.14",
    "@types/express": "^4.17.18",
    "@types/node": "^20.8.2",
    "autoprefixer": "^10.4.14",
    "chokidar": "^3.5.3",
    "cross-env": "^7.0.3",
    "esbuild": "^0.19.5",
    "postcss": "^8.4.27",
    "rimraf": "^5.0.0",
    "tailwindcss": "^3.3.3",
    "tsx": "^3.13.0",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
